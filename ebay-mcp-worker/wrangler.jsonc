{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebay-mcp-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  // Non-secret config. Secrets (set with `wrangler secret put`):
  //   MCP_AUTH_TOKEN, EBAY_CLIENT_ID, EBAY_CLIENT_SECRET, EBAY_USER_REFRESH_TOKEN, EBAY_REDIRECT_URI
  "vars": {
    "EBAY_ENVIRONMENT": "sandbox",
    "EBAY_MARKETPLACE_ID": "EBAY_US",
    "EBAY_MCP_TOOLS": "dynamic",
    "EBAY_READ_ONLY": "false"
  },

  "durable_objects": {
    "bindings": [{ "name": "TOKEN_STORE", "class_name": "TokenStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TokenStore"] }],

  // Worker Previews (`wrangler preview`): bindings/vars are not inherited, so repeat them.
  "previews": {
    "observability": { "enabled": true },
    "vars": {
      "EBAY_ENVIRONMENT": "sandbox",
      "EBAY_MARKETPLACE_ID": "EBAY_US",
      "EBAY_MCP_TOOLS": "dynamic",
      "EBAY_READ_ONLY": "false"
    },
    "durable_objects": {
      "bindings": [{ "name": "TOKEN_STORE", "class_name": "TokenStore" }]
    }
  }
}
